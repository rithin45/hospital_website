---
import {
  ArrowUpRight,
  CalendarDays,
} from "lucide-react";
---

<section class="appointment-cta-section">

  <div class="container-main">

    <!-- =====================================================
         PREMIUM APPOINTMENT PANEL
    ====================================================== -->

    <div class="appointment-cta">

      <!-- Ambient lights -->
      <div class="appointment-orb appointment-orb-one"></div>
      <div class="appointment-orb appointment-orb-two"></div>

      <!-- Fine glass reflection -->
      <div class="appointment-top-reflection"></div>

      <!-- Subtle background texture -->
      <div class="appointment-grid"></div>


      <!-- =================================================
           LEFT CONTENT
      ================================================== -->

      <div class="appointment-content">

        <div class="appointment-label">

          <span class="appointment-label-icon">
            <CalendarDays
              size={14}
              stroke-width={1.7}
            />
          </span>

          <span>Appointment</span>

        </div>


        <h2 class="appointment-title">

          Take the first step
          <span>towards better health.</span>

        </h2>


        <p class="appointment-description">
          Schedule an appointment with our healthcare team
          and take the next step towards better care.
        </p>


        <div class="appointment-trust">

          <span class="appointment-trust-dot"></span>

          <span>
            Compassionate care. Professional attention.
          </span>

        </div>

      </div>


      <!-- =================================================
           PREMIUM ACTION
      ================================================== -->

      <div class="appointment-action">

        <div class="appointment-action-glow"></div>


        <a
          href="/appointment"
          class="appointment-premium-button group"
          aria-label="Book an Appointment"
        >

          <!-- Button text -->

          <span class="appointment-button-copy">

            <span class="appointment-button-small">
              Schedule your visit
            </span>

            <span class="appointment-button-main">
              Book an Appointment
            </span>

          </span>


          <!-- Arrow capsule -->

          <span class="appointment-button-arrow">

            <ArrowUpRight
              size={18}
              stroke-width={1.8}
            />

          </span>


          <!-- Moving shine -->

          <span class="appointment-button-shine"></span>

        </a>


        <div class="appointment-action-meta">

          <span class="appointment-meta-line"></span>

          <span>
            Simple &amp; convenient scheduling
          </span>

        </div>

      </div>


      <!-- Bottom highlight -->
      <div class="appointment-bottom-highlight"></div>

    </div>

  </div>

</section>