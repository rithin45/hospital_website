---
import {
  Clock3,
  UsersRound,
  Building2,
  HeartPulse,
} from "lucide-react";
---

<section class="quick-info">

  <div class="container-main quick-info-container">

    <!-- Section heading -->
    <div class="quick-info-label">
      <span class="quick-info-label-dot"></span>
      <span>Healthcare at a glance</span>
    </div>

    <!-- Glass panel -->
    <div class="quick-info-panel">

      <div class="quick-info-glow quick-info-glow-one"></div>
      <div class="quick-info-glow quick-info-glow-two"></div>

      <div class="quick-info-reflection"></div>

      <!-- 01 -->
      <article class="quick-info-item">
        <div class="quick-info-top">
          <div class="quick-info-icon">
            <Clock3 size={19} stroke-width={1.6} />
          </div>

          <span class="quick-info-number">
            01
          </span>
        </div>

        <div class="quick-info-body">
          <span class="quick-info-small-label">
            Emergency Care
          </span>

          <h3>24 / 7</h3>

          <p>
            Care when you need it most.
          </p>
        </div>

        <div class="quick-info-shine"></div>
      </article>

      <!-- 02 -->
      <article class="quick-info-item">
        <div class="quick-info-top">
          <div class="quick-info-icon">
            <UsersRound size={19} stroke-width={1.6} />
          </div>

          <span class="quick-info-number">
            02
          </span>
        </div>

        <div class="quick-info-body">
          <span class="quick-info-small-label">
            Medical Team
          </span>

          <h3>
            Experienced Doctors
          </h3>

          <p>
            Professional care from our team.
          </p>
        </div>

        <div class="quick-info-shine"></div>
      </article>

      <!-- 03 -->
      <article class="quick-info-item">
        <div class="quick-info-top">
          <div class="quick-info-icon">
            <Building2 size={19} stroke-width={1.6} />
          </div>

          <span class="quick-info-number">
            03
          </span>
        </div>

        <div class="quick-info-body">
          <span class="quick-info-small-label">
            Hospital
          </span>

          <h3>
            Modern Facilities
          </h3>

          <p>
            Designed around patient comfort.
          </p>
        </div>

        <div class="quick-info-shine"></div>
      </article>

      <!-- 04 -->
      <article class="quick-info-item">
        <div class="quick-info-top">
          <div class="quick-info-icon">
            <HeartPulse size={19} stroke-width={1.6} />
          </div>

          <span class="quick-info-number">
            04
          </span>
        </div>

        <div class="quick-info-body">
          <span class="quick-info-small-label">
            Our Approach
          </span>

          <h3>
            Patient-focused Care
          </h3>

          <p>
            Compassion at every step.
          </p>
        </div>

        <div class="quick-info-shine"></div>
      </article>

      <div class="quick-info-bottom-edge"></div>

    </div>

  </div>

</section>