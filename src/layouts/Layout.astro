---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "Health Vision Hospital",
  description =
    "Quality healthcare with compassionate care and modern medical facilities.",
  canonical,
  image = "/hospital.png",
} = Astro.props;

const canonicalUrl =
  canonical ??
  new URL(
    Astro.url.pathname,
    "https://healthvisionhospital.org"
  ).href;

const socialImageUrl = new URL(
  image,
  "https://healthvisionhospital.org"
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

      <link
        rel="canonical"
        href={canonicalUrl}
      />

    <link
      rel="icon"
      href="/logooo.png"
    />
<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Health Vision Hospital" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:alt" content={title} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />
    
  </head>

  <body>

    <!-- =====================================================
         PAGE LOADER
         ===================================================== -->

    <div
      class="page-loader"
      id="page-loader"
      aria-label="Loading Health Vision Hospital"
      role="status"
    >
      <img
        src="/logooo.png"
        alt="Health Vision Hospital"
        class="page-loader-logo"
        width="90"
        height="90"
        decoding="async"
        draggable="false"
      />
    </div>


    <!-- =====================================================
         WEBSITE CONTENT
         ===================================================== -->

    <slot />


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <Footer />


    <!-- =====================================================
         LOADER SCRIPT
         ===================================================== -->

    <script>
      const loaderStartTime = performance.now();

      /*
       * Keep the loader visible for at least 1.2 seconds.
       * This prevents the loader from appearing as a quick
       * blink on fast production/Vercel loads.
       */
      const minimumLoaderTime = 1200;

      const hidePageLoader = () => {
        const loader = document.getElementById("page-loader");

        if (!loader) return;

        const elapsed =
          performance.now() - loaderStartTime;

        const remaining =
          Math.max(
            0,
            minimumLoaderTime - elapsed
          );

        window.setTimeout(() => {

          /*
           * Start fade-out
           */
          loader.classList.add("is-hidden");

          /*
           * Remove loader completely after
           * fade animation finishes.
           */
          window.setTimeout(() => {
            loader.remove();
          }, 450);

        }, remaining);
      };


      /*
       * If the page is already completely loaded,
       * start the loader timer immediately.
       */
      if (document.readyState === "complete") {

        hidePageLoader();

      } else {

        /*
         * Wait until all page resources are loaded.
         */
        window.addEventListener(
          "load",
          hidePageLoader,
          {
            once: true,
          }
        );
      }
    </script>


    <!-- =====================================================
         LOADER CSS
         ===================================================== -->

    <style>

      /* =====================================================
         PAGE LOADER
         ===================================================== */

      .page-loader {
        position: fixed;
        inset: 0;

        z-index: 99999;

        display: flex;
        align-items: center;
        justify-content: center;

        width: 100%;
        height: 100%;

        background:
          linear-gradient(
            180deg,
            #edf8ff 0%,
            #f7fbff 50%,
            #f5f9fd 100%
          );

        opacity: 1;
        visibility: visible;

        /*
         * Smooth fade-out
         */
        transition:
          opacity 0.45s ease,
          visibility 0.45s ease;
      }


      /* =====================================================
         LOGO
         ===================================================== */

      .page-loader-logo {
        display: block;

        width: 90px;
        height: 90px;

        object-fit: contain;

        user-select: none;
        -webkit-user-drag: none;

        /*
         * Subtle premium breathing animation
         */
        animation:
          page-loader-pulse
          1.1s
          ease-in-out
          infinite
          alternate;
      }


      /* =====================================================
         HIDE LOADER
         ===================================================== */

      .page-loader.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }


      /* =====================================================
         LOGO ANIMATION
         ===================================================== */

      @keyframes page-loader-pulse {

        0% {
          transform: scale(0.94);
          opacity: 0.72;
        }

        100% {
          transform: scale(1);
          opacity: 1;
        }

      }


      /* =====================================================
         MOBILE
         ===================================================== */

      @media (max-width: 640px) {

        .page-loader-logo {
          width: 76px;
          height: 76px;
        }

      }


      /* =====================================================
         REDUCED MOTION
         ===================================================== */

      @media (prefers-reduced-motion: reduce) {

        .page-loader {
          transition: none;
        }

        .page-loader-logo {
          animation: none;
        }

      }

    </style>

  </body>
</html>