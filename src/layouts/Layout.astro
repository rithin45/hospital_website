---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Health Vision Hospital",
  description = "Quality healthcare with compassionate care and modern medical facilities."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/logooo.png" />
  </head>

  <body>
    <slot />
    <Footer />
  </body>
</html>