---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

import {
  ArrowRight,
  Images,
  Building2,
  BedDouble,
  Stethoscope,
  ScanLine,
  ShieldCheck,
} from "lucide-react";
---

<Layout
  title="Gallery | Health Vision Hospital"
  description="Explore Health Vision Hospital through our photo gallery."
>
  <Navbar />

  <main class="gallery-page-wrapper">

    <!-- =====================================================
         AMBIENT BACKGROUND
    ====================================================== -->

    <div class="gallery-orb gallery-orb-one"></div>
    <div class="gallery-orb gallery-orb-two"></div>
    <div class="gallery-orb gallery-orb-three"></div>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="gallery-page-header">

      <div class="container-main">

        <div class="gallery-page-header-card glass-card">

          <div class="glass-top-line"></div>
          <div class="glass-shine"></div>

          <div class="gallery-header-content">

            <div class="gallery-header-icon">
              <Images
                size={21}
                strokeWidth={1.8}
              />
            </div>

            <div class="gallery-header-copy">

              <p class="gallery-eyebrow">
                Gallery
              </p>

              <h1 class="gallery-page-title">
                A closer look at Health Vision Hospital
              </h1>

              <p class="gallery-page-description">
                Explore our hospital environment, facilities and patient care
                spaces.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         GALLERY
    ====================================================== -->

    <section class="gallery-section">

      <div class="container-main">

        <div class="gallery-section-heading">

          <div>

            <p class="gallery-section-eyebrow">
              Inside Health Vision
            </p>

            <h2 class="gallery-section-title">
              Our hospital spaces
            </h2>

          </div>

          <p class="gallery-section-description">
            A glimpse into the spaces created around comfort,
            care and a better patient experience.
          </p>

        </div>


        <!-- =================================================
             GALLERY GRID
        ================================================== -->

        <div class="gallery-grid">


          <!-- =================================================
               IMAGE 01
          ================================================== -->

          <article class="gallery-item gallery-item-large">

            <div class="gallery-image gallery-image-one">

              <div class="gallery-image-light"></div>

              <div class="gallery-image-pattern"></div>

              <div class="gallery-image-content">

                <div class="gallery-image-icon">
                  <Building2
                    size={21}
                    strokeWidth={1.8}
                  />
                </div>

                <div class="gallery-image-text">

                  <span class="gallery-image-number">
                    01
                  </span>

                  <span class="gallery-placeholder">
                    Hospital Exterior
                  </span>

                </div>

                <ArrowRight
                  class="gallery-image-arrow"
                  size={19}
                  strokeWidth={2}
                />

              </div>

            </div>

          </article>


          <!-- =================================================
               IMAGE 02
          ================================================== -->

          <article class="gallery-item">

            <div class="gallery-image gallery-image-two">

              <div class="gallery-image-light"></div>

              <div class="gallery-image-pattern"></div>

              <div class="gallery-image-content">

                <div class="gallery-image-icon">
                  <Building2
                    size={21}
                    strokeWidth={1.8}
                  />
                </div>

                <div class="gallery-image-text">

                  <span class="gallery-image-number">
                    02
                  </span>

                  <span class="gallery-placeholder">
                    Reception
                  </span>

                </div>

                <ArrowRight
                  class="gallery-image-arrow"
                  size={19}
                  strokeWidth={2}
                />

              </div>

            </div>

          </article>


          <!-- =================================================
               IMAGE 03
          ================================================== -->

          <article class="gallery-item">

            <div class="gallery-image gallery-image-three">

              <div class="gallery-image-light"></div>

              <div class="gallery-image-pattern"></div>

              <div class="gallery-image-content">

                <div class="gallery-image-icon">
                  <Stethoscope
                    size={21}
                    strokeWidth={1.8}
                  />
                </div>

                <div class="gallery-image-text">

                  <span class="gallery-image-number">
                    03
                  </span>

                  <span class="gallery-placeholder">
                    Consultation Room
                  </span>

                </div>

                <ArrowRight
                  class="gallery-image-arrow"
                  size={19}
                  strokeWidth={2}
                />

              </div>

            </div>

          </article>


          <!-- =================================================
               IMAGE 04
          ================================================== -->

          <article class="gallery-item">

            <div class="gallery-image gallery-image-four">

              <div class="gallery-image-light"></div>

              <div class="gallery-image-pattern"></div>

              <div class="gallery-image-content">

                <div class="gallery-image-icon">
                  <BedDouble
                    size={21}
                    strokeWidth={1.8}
                  />
                </div>

                <div class="gallery-image-text">

                  <span class="gallery-image-number">
                    04
                  </span>

                  <span class="gallery-placeholder">
                    Patient Room
                  </span>

                </div>

                <ArrowRight
                  class="gallery-image-arrow"
                  size={19}
                  strokeWidth={2}
                />

              </div>

            </div>

          </article>


          <!-- =================================================
               IMAGE 05
          ================================================== -->

          <article class="gallery-item">

            <div class="gallery-image gallery-image-five">

              <div class="gallery-image-light"></div>

              <div class="gallery-image-pattern"></div>

              <div class="gallery-image-content">

                <div class="gallery-image-icon">
                  <ScanLine
                    size={21}
                    strokeWidth={1.8}
                  />
                </div>

                <div class="gallery-image-text">

                  <span class="gallery-image-number">
                    05
                  </span>

                  <span class="gallery-placeholder">
                    Medical Facilities
                  </span>

                </div>

                <ArrowRight
                  class="gallery-image-arrow"
                  size={19}
                  strokeWidth={2}
                />

              </div>

            </div>

          </article>


          <!-- =================================================
               IMAGE 06
          ================================================== -->

          <article class="gallery-item gallery-item-large">

            <div class="gallery-image gallery-image-six">

              <div class="gallery-image-light"></div>

              <div class="gallery-image-pattern"></div>

              <div class="gallery-image-content">

                <div class="gallery-image-icon">
                  <ShieldCheck
                    size={21}
                    strokeWidth={1.8}
                  />
                </div>

                <div class="gallery-image-text">

                  <span class="gallery-image-number">
                    06
                  </span>

                  <span class="gallery-placeholder">
                    Hospital Interior
                  </span>

                </div>

                <ArrowRight
                  class="gallery-image-arrow"
                  size={19}
                  strokeWidth={2}
                />

              </div>

            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="gallery-cta">

      <div class="container-main">

        <div class="gallery-cta-card">

          <div class="cta-glow cta-glow-one"></div>
          <div class="cta-glow cta-glow-two"></div>

          <div class="cta-highlight"></div>

          <div class="gallery-cta-inner">

            <p class="cta-eyebrow">
              Health Vision Hospital
            </p>

            <h2 class="gallery-cta-title">
              Have questions about our hospital?
            </h2>

            <p class="gallery-cta-description">
              Our team is available to help you with your healthcare needs
              and guide you through your next visit.
            </p>


            <!-- =================================================
                 CTA ACTIONS
            ================================================== -->

            <div class="gallery-cta-actions">


              <!-- BOOK APPOINTMENT -->

              <a
                href="/appointment"
                class="premium-button premium-button-primary"
              >

                <span class="premium-button-shine"></span>

                <span class="premium-button-content">

                  <span class="premium-button-label">
                    Start Your Visit
                  </span>

                  <span class="premium-button-text">
                    Book Appointment
                  </span>

                </span>

                <span class="premium-button-arrow">
                  <ArrowRight
                    size={19}
                    strokeWidth={2.4}
                  />
                </span>

              </a>


              <!-- CONTACT -->

              <a
                href="/contact"
                class="premium-button premium-button-secondary"
              >

                <span class="premium-button-shine"></span>

                <span class="premium-button-content">

                  <span class="premium-button-label">
                    Need Assistance
                  </span>

                  <span class="premium-button-text">
                    Contact Us
                  </span>

                </span>

                <span class="premium-button-arrow">
                  <ArrowRight
                    size={19}
                    strokeWidth={2.4}
                  />
                </span>

              </a>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>
</Layout>


<style>

/* =========================================================
   PAGE WRAPPER
========================================================= */

.gallery-page-wrapper {

  position: relative;

  width: 100%;

  min-height: 100vh;

  overflow: hidden;

  background:
    #edf5fd;
}


/* =========================================================
   AMBIENT ORBS
========================================================= */

.gallery-orb {

  position: absolute;

  border-radius: 50%;

  filter: blur(105px);

  pointer-events: none;

  z-index: 0;
}


.gallery-orb-one {

  width: 560px;
  height: 560px;

  top: -140px;
  left: -150px;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .28),
      rgba(11, 120, 199, .08) 70%,
      transparent
    );
}


.gallery-orb-two {

  width: 650px;
  height: 650px;

  top: 35%;
  right: -220px;

  background:
    radial-gradient(
      circle,
      rgba(3, 84, 165, .18),
      rgba(60, 195, 252, .09) 70%,
      transparent
    );
}


.gallery-orb-three {

  width: 700px;
  height: 700px;

  bottom: -260px;
  left: 10%;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .18),
      rgba(3, 84, 165, .08) 70%,
      transparent
    );
}


section {

  position: relative;

  z-index: 1;
}


/* =========================================================
   GLASS CARD
========================================================= */

.glass-card {

  position: relative;

  overflow: hidden;

  border:
    1px solid rgba(255, 255, 255, .74);

  border-radius: 32px;

  background:
    rgba(255, 255, 255, .58);

  backdrop-filter:
    blur(25px) saturate(180%);

  -webkit-backdrop-filter:
    blur(25px) saturate(180%);

  box-shadow:
    0 24px 55px rgba(3, 84, 165, .08),
    0 8px 20px rgba(3, 84, 165, .035),
    inset 0 1px 0 rgba(255, 255, 255, .85),
    inset 0 -1px 0 rgba(0, 0, 0, .025);

  transition:
    transform .5s cubic-bezier(.22, 1, .36, 1),
    box-shadow .5s ease,
    background .5s ease;
}


.glass-card:hover {

  transform:
    translateY(-4px);

  background:
    rgba(255, 255, 255, .72);

  box-shadow:
    0 30px 65px rgba(3, 84, 165, .12),
    0 10px 25px rgba(3, 84, 165, .05),
    inset 0 1px 0 rgba(255, 255, 255, .95);
}


/* =========================================================
   GLASS TOP LINE
========================================================= */

.glass-top-line {

  position: absolute;

  top: 1px;

  left: 25px;
  right: 25px;

  height: 1px;

  background:
    rgba(255, 255, 255, .92);

  pointer-events: none;

  z-index: 5;
}


/* =========================================================
   GLASS SHINE
========================================================= */

.glass-shine {

  position: absolute;

  top: -100%;
  left: -45%;

  width: 34%;
  height: 300%;

  transform:
    rotate(22deg);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, .30),
      transparent
    );

  pointer-events: none;

  z-index: 4;

  transition:
    left .85s cubic-bezier(.22, 1, .36, 1);
}


.glass-card:hover
.glass-shine {

  left: 125%;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.gallery-page-header {

  width: 100%;

  padding-top: 156px;

  padding-bottom: 90px;
}


.gallery-page-header-card {

  max-width: 900px;

  padding:
    48px;
}


.gallery-header-content {

  position: relative;

  z-index: 6;

  display: flex;

  align-items: flex-start;

  gap: 24px;
}


.gallery-header-icon {

  flex:
    0 0 56px;

  width: 56px;
  height: 56px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #0354a5;

  border:
    1px solid rgba(255, 255, 255, .90);

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, .98),
      rgba(232, 248, 255, .88)
    );

  box-shadow:
    0 10px 25px rgba(3, 84, 165, .08),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}


.gallery-header-copy {

  min-width: 0;
}


.gallery-eyebrow {

  margin: 0;

  color: #0354a5;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .14em;

  line-height: 1.4;

  text-transform: uppercase;
}


.gallery-page-title {

  max-width: 780px;

  margin:
    14px 0 0;

  color: #061a31;

  font-size:
    clamp(42px, 5vw, 68px);

  font-weight: 600;

  line-height: 1.04;

  letter-spacing: -.045em;
}


.gallery-page-description {

  max-width: 680px;

  margin:
    22px 0 0;

  color: #60758b;

  font-size: 17px;

  line-height: 1.75;
}


/* =========================================================
   GALLERY SECTION
========================================================= */

.gallery-section {

  width: 100%;

  padding:
    20px 0 110px;
}


.gallery-section-heading {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 40px;

  margin-bottom: 45px;
}


.gallery-section-eyebrow {

  margin: 0;

  color: #0354a5;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .14em;

  text-transform: uppercase;
}


.gallery-section-title {

  margin:
    9px 0 0;

  color: #102a43;

  font-size:
    clamp(30px, 3vw, 43px);

  font-weight: 650;

  line-height: 1.12;

  letter-spacing: -.035em;
}


.gallery-section-description {

  max-width: 420px;

  margin: 0;

  color: #60758b;

  font-size: 14px;

  line-height: 1.7;

  text-align: right;
}


/* =========================================================
   GALLERY GRID
========================================================= */

.gallery-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 22px;
}


/* =========================================================
   GALLERY ITEM
========================================================= */

.gallery-item {

  position: relative;

  min-width: 0;

  overflow: hidden;

  border:
    1px solid rgba(255, 255, 255, .78);

  border-radius: 28px;

  background:
    rgba(255, 255, 255, .45);

  box-shadow:
    0 17px 40px rgba(3, 84, 165, .07),
    inset 0 1px 0 rgba(255, 255, 255, .88);

  transition:
    transform .55s cubic-bezier(.22, 1, .36, 1),
    box-shadow .55s ease,
    border-color .55s ease;
}


.gallery-item:hover {

  transform:
    translateY(-6px);

  border-color:
    rgba(255, 255, 255, .96);

  box-shadow:
    0 28px 55px rgba(3, 84, 165, .13),
    0 8px 20px rgba(3, 84, 165, .04),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}


/* =========================================================
   GALLERY IMAGE
========================================================= */

.gallery-image {

  position: relative;

  width: 100%;

  aspect-ratio: 4 / 3;

  display: flex;

  align-items: flex-end;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #dff5ff,
      #edf9ff 48%,
      #d8effd
    );

  transition:
    transform .7s cubic-bezier(.22, 1, .36, 1);
}


.gallery-item:hover
.gallery-image {

  transform:
    scale(1.025);
}


/* =========================================================
   DIFFERENT IMAGE TONES
========================================================= */

.gallery-image-one {

  background:
    linear-gradient(
      145deg,
      #d6f3ff,
      #edfaff 48%,
      #cdeafb
    );
}


.gallery-image-two {

  background:
    linear-gradient(
      145deg,
      #f3faff,
      #e5f5fc 48%,
      #d9edf7
    );
}


.gallery-image-three {

  background:
    linear-gradient(
      145deg,
      #dff7ff,
      #effbff 48%,
      #d5edf9
    );
}


.gallery-image-four {

  background:
    linear-gradient(
      145deg,
      #f5fbff,
      #e7f5fc 48%,
      #dceef8
    );
}


.gallery-image-five {

  background:
    linear-gradient(
      145deg,
      #d9f4ff,
      #edfaff 48%,
      #d0eafa
    );
}


.gallery-image-six {

  background:
    linear-gradient(
      145deg,
      #e7f8ff,
      #f4fbff 48%,
      #d7edf8
    );
}


/* =========================================================
   IMAGE LIGHT
========================================================= */

.gallery-image-light {

  position: absolute;

  width: 420px;
  height: 420px;

  top: -210px;
  left: -190px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255, 255, 255, .88),
      rgba(255, 255, 255, .20) 50%,
      transparent 72%
    );

  filter: blur(2px);

  pointer-events: none;

  transition:
    transform .7s cubic-bezier(.22, 1, .36, 1);
}


.gallery-item:hover
.gallery-image-light {

  transform:
    translate(35px, 25px);
}


/* =========================================================
   IMAGE PATTERN
========================================================= */

.gallery-image-pattern {

  position: absolute;

  width: 360px;
  height: 360px;

  right: -190px;
  bottom: -190px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(3, 84, 165, .13),
      transparent 70%
    );

  pointer-events: none;
}


/* =========================================================
   IMAGE CONTENT
========================================================= */

.gallery-image-content {

  position: relative;

  z-index: 5;

  width: calc(100% - 30px);

  margin:
    15px;

  padding:
    12px;

  display: flex;

  align-items: center;

  gap: 12px;

  border:
    1px solid rgba(255, 255, 255, .76);

  border-radius: 18px;

  background:
    rgba(255, 255, 255, .60);

  backdrop-filter:
    blur(16px);

  -webkit-backdrop-filter:
    blur(16px);

  box-shadow:
    0 12px 26px rgba(3, 70, 129, .07),
    inset 0 1px 0 rgba(255, 255, 255, .92);

  transition:
    transform .45s cubic-bezier(.22, 1, .36, 1),
    background .45s ease;
}


.gallery-item:hover
.gallery-image-content {

  transform:
    translateY(-2px);

  background:
    rgba(255, 255, 255, .72);
}


/* =========================================================
   IMAGE ICON
========================================================= */

.gallery-image-icon {

  flex:
    0 0 40px;

  width: 40px;
  height: 40px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #0354a5;

  border:
    1px solid rgba(255, 255, 255, .86);

  border-radius: 12px;

  background:
    rgba(255, 255, 255, .78);

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 1);
}


/* =========================================================
   IMAGE TEXT
========================================================= */

.gallery-image-text {

  min-width: 0;

  flex: 1;

  display: flex;

  flex-direction: column;

  gap: 3px;
}


.gallery-image-number {

  color:
    rgba(3, 84, 165, .50);

  font-size: 7px;

  font-weight: 800;

  letter-spacing: .14em;

  line-height: 1;

  text-transform: uppercase;
}


.gallery-placeholder {

  overflow: hidden;

  color: #034681;

  font-size: 12px;

  font-weight: 750;

  line-height: 1.3;

  text-overflow: ellipsis;

  white-space: nowrap;
}


/* =========================================================
   IMAGE ARROW
========================================================= */

.gallery-image-arrow {

  flex:
    0 0 auto;

  color: #0354a5;

  transition:
    transform .4s cubic-bezier(.22, 1, .36, 1);
}


.gallery-item:hover
.gallery-image-arrow {

  transform:
    translateX(4px);
}


/* =========================================================
   CTA
========================================================= */

.gallery-cta {

  width: 100%;

  padding:
    20px 0 110px;
}


.gallery-cta-card {

  position: relative;

  overflow: hidden;

  padding:
    82px 40px;

  border:
    1px solid rgba(255, 255, 255, .34);

  border-radius: 36px;

  background:
    linear-gradient(
      135deg,
      #034681 0%,
      #0757a6 42%,
      #0b78c7 72%,
      #3cc3fc 100%
    );

  box-shadow:
    0 30px 65px rgba(3, 84, 165, .23),
    0 10px 25px rgba(3, 84, 165, .10),
    inset 0 1px 0 rgba(255, 255, 255, .38),
    inset 0 -1px 0 rgba(0, 0, 0, .10);
}


/* =========================================================
   CTA GLOWS
========================================================= */

.cta-glow {

  position: absolute;

  border-radius: 50%;

  pointer-events: none;

  filter: blur(20px);
}


.cta-glow-one {

  width: 440px;
  height: 440px;

  top: -260px;
  right: -90px;

  background:
    radial-gradient(
      circle,
      rgba(255, 255, 255, .18),
      transparent 70%
    );
}


.cta-glow-two {

  width: 380px;
  height: 380px;

  bottom: -250px;
  left: -110px;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .22),
      transparent 70%
    );
}


.cta-highlight {

  position: absolute;

  top: 1px;

  left: 30px;
  right: 30px;

  height: 1px;

  background:
    rgba(255, 255, 255, .42);
}


/* =========================================================
   CTA CONTENT
========================================================= */

.gallery-cta-inner {

  position: relative;

  z-index: 5;

  max-width: 780px;

  margin-inline: auto;

  text-align: center;
}


.cta-eyebrow {

  margin: 0;

  color:
    rgba(255, 255, 255, .76);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .15em;

  text-transform: uppercase;
}


.gallery-cta-title {

  margin:
    13px 0 0;

  color: #ffffff;

  font-size:
    clamp(34px, 4vw, 50px);

  font-weight: 650;

  line-height: 1.08;

  letter-spacing: -.04em;
}


.gallery-cta-description {

  max-width: 590px;

  margin:
    19px auto 0;

  color:
    rgba(232, 248, 255, .92);

  font-size: 16px;

  line-height: 1.7;
}


/* =========================================================
   CTA ACTIONS
========================================================= */

.gallery-cta-actions {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 14px;

  margin-top: 34px;
}


/* =========================================================
   PREMIUM BUTTON
========================================================= */

