---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout
  title="Privacy Policy | Health Vision Hospital"
  description="Privacy Policy for Health Vision Hospital."
>
  <Navbar />

  <main>

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="legal-page-header">

      <div class="container-main">

        <div class="legal-page-header-content">

          <p class="legal-eyebrow">
            Legal
          </p>

          <h1 class="legal-page-title">
            Privacy Policy
          </h1>

          <p class="legal-updated">
            Last updated: September 2026
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         PRIVACY POLICY CONTENT
    ====================================================== -->

    <section class="legal-content-section">

      <div class="container-main">

        <article class="legal-content">

          <h2>
            1. Introduction
          </h2>

          <p>
            Health Vision Hospital respects your privacy and is committed
            to protecting the information you provide when using this
            website.
          </p>

          <p>
            This Privacy Policy explains how information submitted through
            this website may be collected, used and protected.
          </p>


          <h2>
            2. Information We May Collect
          </h2>

          <p>
            When you contact us or request an appointment, we may collect
            information such as:
          </p>

          <ul>
            <li>Your name</li>
            <li>Phone number</li>
            <li>Email address</li>
            <li>Preferred appointment date and time</li>
            <li>Department or service requested</li>
            <li>Information included in your enquiry</li>
          </ul>


          <h2>
            3. How We Use Information
          </h2>

          <p>
            Information submitted through this website may be used to:
          </p>

          <ul>
            <li>Respond to enquiries</li>
            <li>Process appointment requests</li>
            <li>Contact you regarding your request</li>
            <li>Provide information about hospital services</li>
            <li>Improve the website and user experience</li>
          </ul>


          <h2>
            4. Medical Information
          </h2>

          <p>
            The website's appointment and enquiry forms should not be used
            to submit highly sensitive medical information unless the
            hospital specifically instructs you to do so.
          </p>

          <p>
            For urgent medical concerns, please contact the hospital
            directly or seek appropriate emergency medical assistance.
          </p>


          <h2>
            5. Cookies and Website Analytics
          </h2>

          <p>
            The website may use cookies or similar technologies where
            required for functionality, security, analytics or improving
            the user experience.
          </p>

          <p>
            Any third-party analytics or services used on the website
            should be identified and updated in this policy before the
            website is published.
          </p>


          <h2>
            6. Third-Party Services
          </h2>

          <p>
            The website may contain links to or integrations with
            third-party services such as maps, social media platforms,
            analytics providers or other external services.
          </p>

          <p>
            Third-party services may have their own privacy policies and
            terms that apply to information processed through their
            platforms.
          </p>


          <h2>
            7. Data Security
          </h2>

          <p>
            We take reasonable measures to protect information submitted
            through this website from unauthorized access, misuse or
            disclosure.
          </p>

          <p>
            However, no internet transmission or electronic storage system
            can be guaranteed to be completely secure.
          </p>


          <h2>
            8. Data Retention
          </h2>

          <p>
            Information may be retained for as long as reasonably
            necessary to respond to enquiries, manage appointment requests,
            comply with applicable requirements and maintain appropriate
            records.
          </p>


          <h2>
            9. Your Rights
          </h2>

          <p>
            Depending on applicable law, you may have rights relating to
            personal information you have provided, including requesting
            access, correction or deletion where applicable.
          </p>


          <h2>
            10. Contact Us
          </h2>

          <p>
            If you have questions regarding this Privacy Policy or how
            information submitted through this website is handled, please
            contact us.
          </p>

          <p class="legal-contact">
            <strong>Email:</strong>

            <a
              href="mailto:info@healthvisionhospital.org"
            >
              info@healthvisionhospital.org
            </a>
          </p>

        </article>

      </div>

    </section>

  </main>
</Layout>

<style>
  /* =========================================================
     LEGAL PAGE HEADER
     ========================================================= */

  .legal-page-header {
    width: 100%;
    padding-top: 156px;
    padding-bottom: 78px;
    background:
      linear-gradient(
        180deg,
        #eaf8ff 0%,
        #f6fbff 100%
      );
  }

  .legal-page-header-content {
    max-width: 900px;
    min-width: 0;
  }

  .legal-eyebrow {
    margin: 0;
    color: #0757a6;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .legal-page-title {
    margin: 18px 0 0;
    color: #061a31;
    font-size:
      clamp(
        42px,
        5vw,
        60px
      );
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .legal-updated {
    margin: 18px 0 0;
    color: #60758b;
    font-size: 14px;
    line-height: 1.6;
  }

  /* =========================================================
     LEGAL CONTENT
     ========================================================= */

  .legal-content-section {
    width: 100%;
    padding-top: 80px;
    padding-bottom: 100px;
    background: #ffffff;
  }

  .legal-content {
    max-width: 900px;
    margin-inline: auto;
    min-width: 0;
    color: #475f75;
    font-size: 15px;
    line-height: 1.85;
  }

  /* =========================================================
     HEADINGS
     ========================================================= */

  .legal-content h2 {
    margin: 48px 0 0;
    color: #102a43;
    font-size: 23px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .legal-content h2:first-child {
    margin-top: 0;
  }

  /* =========================================================
     PARAGRAPHS
     ========================================================= */

  .legal-content p {
    max-width: 850px;
    margin: 18px 0 0;
  }

  .legal-content h2 + p {
    margin-top: 16px;
  }

  /* =========================================================
     LISTS
     ========================================================= */

  .legal-content ul {
    max-width: 820px;
    margin: 16px 0 0;
    padding-left: 22px;
  }

  .legal-content li {
    margin-top: 7px;
    padding-left: 4px;
  }

  .legal-content li::marker {
    color: #0757a6;
  }

  /* =========================================================
     CONTACT
     ========================================================= */

  .legal-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .legal-contact strong {
    color: #3f5f78;
  }

  .legal-contact a {
    color: #0757a6;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 180ms ease;
  }

  .legal-contact a:hover {
    color: #034681;
    text-decoration: underline;
  }

  /* =========================================================
     LARGE DESKTOP
     ========================================================= */

  @media (min-width: 1440px) {

    .legal-page-header {
      padding-top: 166px;
      padding-bottom: 90px;
    }

    .legal-content-section {
      padding-top: 95px;
      padding-bottom: 115px;
    }

  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 1023px) {

    .legal-page-header {
      padding-top: 138px;
      padding-bottom: 68px;
    }

    .legal-content-section {
      padding-top: 70px;
      padding-bottom: 80px;
    }

    .legal-content {
      max-width: 820px;
    }

  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 640px) {

    .legal-page-header {
      padding-top: 122px;
      padding-bottom: 58px;
    }

    .legal-page-title {
      margin-top: 14px;
      font-size:
        clamp(
          36px,
          10vw,
          48px
        );
    }

    .legal-updated {
      margin-top: 15px;
      font-size: 13px;
    }

    .legal-content-section {
      padding-top: 60px;
      padding-bottom: 70px;
    }

    .legal-content {
      font-size: 14px;
      line-height: 1.8;
    }

    .legal-content h2 {
      margin-top: 40px;
      font-size: 21px;
    }

    .legal-content h2 + p {
      margin-top: 14px;
    }

    .legal-content p {
      margin-top: 16px;
    }

    .legal-content ul {
      margin-top: 14px;
      padding-left: 20px;
    }

    .legal-content li {
      margin-top: 6px;
    }

    .legal-contact {
      align-items: flex-start;
      flex-direction: column;
      gap: 3px;
    }

  }

  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media (max-width: 380px) {

    .legal-page-header {
      padding-top: 116px;
      padding-bottom: 52px;
    }

    .legal-page-title {
      font-size: 34px;
    }

    .legal-content-section {
      padding-top: 52px;
    }

    .legal-content h2 {
      font-size: 20px;
    }

  }
</style>