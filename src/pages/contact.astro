---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

import {
  MapPin,
  Phone,
  Mail,
  Clock3,
  Navigation,
  ArrowRight,
  MessageCircle,
  CalendarDays,
} from "lucide-react";
---

<Layout
  title="Contact Health Vision Hospital | Palakkad, Kerala"
  description="Contact Health Vision Hospital in Palakkad, Kerala. Find our location, phone number, email address and opening hours."
>
  <Navbar />

  <main class="contact-page">

    <!-- =====================================================
         AMBIENT BACKGROUND
    ====================================================== -->

    <div class="contact-orb contact-orb-one"></div>
    <div class="contact-orb contact-orb-two"></div>
    <div class="contact-orb contact-orb-three"></div>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="contact-page-header">

      <div class="container-main">

        <div class="contact-header-card glass-card">

          <div class="glass-top-line"></div>
          <div class="glass-shine"></div>

          <div class="contact-header-content">

            <div class="contact-header-icon">

              <MessageCircle
                size={22}
                strokeWidth={1.8}
              />

            </div>

            <div class="contact-header-copy">

              <p class="contact-eyebrow">
                Contact Us
              </p>

              <h1 class="contact-page-title">
                We're here to help
              </h1>

              <p class="contact-page-description">
                Get in touch with Health Vision Hospital for appointments,
                enquiries and general information.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CONTACT INFORMATION
    ====================================================== -->

    <section class="contact-information">

      <div class="container-main">

        <div class="contact-section-heading">

          <div>

            <p class="contact-section-eyebrow">
              Reach Us
            </p>

            <h2 class="contact-section-title">
              Everything you need to connect
            </h2>

          </div>

          <p class="contact-section-description">
            Whether you need directions, an appointment or general
            information, our team is ready to assist you.
          </p>

        </div>


        <div class="contact-information-grid">


          <!-- =================================================
               ADDRESS
          ================================================== -->

          <article class="contact-info-card">

            <div class="contact-card-top">

              <div class="contact-info-icon">

                <MapPin
                  size={21}
                  strokeWidth={1.8}
                />

              </div>

              <span class="contact-card-number">
                01
              </span>

            </div>

            <h2 class="contact-info-title">
              Address
            </h2>

            <p class="contact-info-text">
              Hospital Address<br />
              Kerala, India
            </p>

            <a
              href="#map"
              class="contact-card-link"
            >
              View location
              <ArrowRight
                size={15}
                strokeWidth={2}
              />
            </a>

          </article>


          <!-- =================================================
               PHONE
          ================================================== -->

          <article class="contact-info-card">

            <div class="contact-card-top">

              <div class="contact-info-icon">

                <Phone
                  size={21}
                  strokeWidth={1.8}
                />

              </div>

              <span class="contact-card-number">
                02
              </span>

            </div>

            <h2 class="contact-info-title">
              Phone
            </h2>

            <a
              href="tel:+919074923153"
              class="contact-info-link"
            >
              +91 9074923153
            </a>

            <a
              href="tel:+919074923153"
              class="contact-card-link"
            >
              Call the hospital
              <ArrowRight
                size={15}
                strokeWidth={2}
              />
            </a>

          </article>


          <!-- =================================================
               EMAIL
          ================================================== -->

          <article class="contact-info-card">

            <div class="contact-card-top">

              <div class="contact-info-icon">

                <Mail
                  size={21}
                  strokeWidth={1.8}
                />

              </div>

              <span class="contact-card-number">
                03
              </span>

            </div>

            <h2 class="contact-info-title">
              Email
            </h2>

            <a
              href="mailto:info@healthvisionhospital.org"
              class="contact-info-link contact-email"
            >
              info@healthvisionhospital.org
            </a>

            <a
              href="mailto:info@healthvisionhospital.org"
              class="contact-card-link"
            >
              Send an email
              <ArrowRight
                size={15}
                strokeWidth={2}
              />
            </a>

          </article>


          <!-- =================================================
               HOURS
          ================================================== -->

          <article class="contact-info-card">

            <div class="contact-card-top">

              <div class="contact-info-icon">

                <Clock3
                  size={21}
                  strokeWidth={1.8}
                />

              </div>

              <span class="contact-card-number">
                04
              </span>

            </div>

            <h2 class="contact-info-title">
  Opening Hours
</h2>

<p class="contact-info-text">
  Monday – Sunday<br />
  Open 24 Hours
</p>

<span class="contact-status">
  <span class="contact-status-dot"></span>
  Open 24 Hours
</span>
          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         MAP + CONTACT CTA
    ====================================================== -->

    <section class="contact-main-section">

      <div class="container-main">

        <div class="contact-main-grid">


          <!-- =================================================
               MAP
          ================================================== -->

          <div
            class="contact-map-card"
            id="map"
          >

            <div class="contact-map-placeholder contact-real-map">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3922.702881982931!2d76.53698969999999!3d10.5240516!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba809a37c0468c5%3A0x7bdebe54ff4df2df!2sHealth%20Vision%20Medical%20Center!5e0!3m2!1sen!2sin!4v1791095829301!5m2!1sen!2sin"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>


            <div class="contact-map-footer">

              <div class="map-footer-info">

                <span class="map-footer-label">
                  FIND US
                </span>

                <span class="map-footer-text">
                  Kerala, India
                </span>

              </div>

              <a
                  href="https://maps.app.goo.gl/gVZYTmHMeBk3YB1t7?g_st=aw"
                  class="directions-button"
                  target="_blank"
                  rel="noopener noreferrer"
                >

                <Navigation
                  size={16}
                  strokeWidth={2}
                />

                <span>
                  Get Directions
                </span>

                <ArrowRight
                  size={15}
                  strokeWidth={2}
                />

              </a>

            </div>

          </div>


          <!-- =================================================
               CONTACT HELP
          ================================================== -->

          <div class="contact-help-card">

            <div class="contact-help-glow contact-help-glow-one"></div>
            <div class="contact-help-glow contact-help-glow-two"></div>

            <div class="contact-help-line"></div>

            <div class="contact-help-content">

              <div class="contact-help-icon">

                <MessageCircle
                  size={21}
                  strokeWidth={1.8}
                />

              </div>

              <p class="contact-help-eyebrow">
                Get in Touch
              </p>

              <h2 class="contact-help-title">
                Have a question?
              </h2>

              <p class="contact-help-description">
                Our team is available to help with appointments, hospital
                information and general enquiries.
              </p>


              <!-- =================================================
                   CALL / EMAIL
              ================================================== -->

              <div class="contact-help-actions">


                <a
                  href="tel:+919074923153"
                  class="contact-help-action"
                >

                  <span class="contact-help-action-icon">

                    <Phone
                      size={18}
                      strokeWidth={1.8}
                    />

                  </span>

                  <span class="contact-help-action-content">

                    <span class="contact-help-action-label">
                      CONTACT
                    </span>

                    <span class="contact-help-action-title">
                      Call the Hospital
                    </span>

                  </span>

                  <ArrowRight
                    class="contact-help-action-arrow"
                    size={17}
                    strokeWidth={2}
                  />

                </a>


                <a
                  href="mailto:info@healthvisionhospital.org"
                  class="contact-help-action"
                >

                  <span class="contact-help-action-icon">

                    <Mail
                      size={18}
                      strokeWidth={1.8}
                    />

                  </span>

                  <span class="contact-help-action-content">

                    <span class="contact-help-action-label">
                      EMAIL
                    </span>

                    <span class="contact-help-action-title">
                      Email Us
                    </span>

                  </span>

                  <ArrowRight
                    class="contact-help-action-arrow"
                    size={17}
                    strokeWidth={2}
                  />

                </a>

              </div>


              <!-- =================================================
                   APPOINTMENT BUTTON
              ================================================== -->

              <a
                href="/appointment"
                class="premium-button"
              >

                <span class="premium-button-shine"></span>

                <span class="premium-button-content">

                  <span class="premium-button-label">
                    START YOUR VISIT
                  </span>

                  <span class="premium-button-text">
                    Request an Appointment
                  </span>

                </span>

                <span class="premium-button-arrow">

                  <ArrowRight
                    size={19}
                    strokeWidth={2.4}
                  />

                </span>

              </a>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>
</Layout>


<style>

/* =========================================================
   PAGE
========================================================= */

.contact-page {

  position: relative;

  width: 100%;

  min-height: 100vh;

  overflow: hidden;

  background:
    #edf5fd;
}


/* =========================================================
   AMBIENT ORBS
========================================================= */

.contact-orb {

  position: absolute;

  border-radius: 50%;

  filter: blur(110px);

  pointer-events: none;

  z-index: 0;
}


.contact-orb-one {

  width: 560px;
  height: 560px;

  top: -180px;
  left: -180px;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .25),
      rgba(11, 120, 199, .08) 70%,
      transparent
    );
}


.contact-orb-two {

  width: 620px;
  height: 620px;

  top: 38%;
  right: -250px;

  background:
    radial-gradient(
      circle,
      rgba(3, 84, 165, .18),
      rgba(60, 195, 252, .07) 70%,
      transparent
    );
}


.contact-orb-three {

  width: 650px;
  height: 650px;

  bottom: -300px;
  left: 10%;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .16),
      transparent 70%
    );
}


section {

  position: relative;

  z-index: 1;
}


/* =========================================================
   GLASS CARD
========================================================= */

.glass-card {

  position: relative;

  overflow: hidden;

  border:
    1px solid rgba(255, 255, 255, .76);

  border-radius: 32px;

  background:
    rgba(255, 255, 255, .58);

  backdrop-filter:
    blur(25px) saturate(180%);

  -webkit-backdrop-filter:
    blur(25px) saturate(180%);

  box-shadow:
    0 25px 60px rgba(3, 84, 165, .08),
    0 8px 20px rgba(3, 84, 165, .035),
    inset 0 1px 0 rgba(255, 255, 255, .90);

  transition:
    transform .5s cubic-bezier(.22, 1, .36, 1),
    box-shadow .5s ease;
}


.glass-card:hover {

  transform:
    translateY(-4px);

  box-shadow:
    0 32px 70px rgba(3, 84, 165, .12),
    inset 0 1px 0 rgba(255, 255, 255, .98);
}


.glass-top-line {

  position: absolute;

  top: 1px;

  left: 25px;
  right: 25px;

  height: 1px;

  background:
    rgba(255, 255, 255, .92);

  z-index: 5;
}


.glass-shine {

  position: absolute;

  top: -100%;
  left: -45%;

  width: 34%;
  height: 300%;

  transform:
    rotate(22deg);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, .30),
      transparent
    );

  pointer-events: none;

  z-index: 4;

  transition:
    left .85s cubic-bezier(.22, 1, .36, 1);
}


.glass-card:hover .glass-shine {

  left: 125%;
}


/* =========================================================
   HEADER
========================================================= */

.contact-page-header {

  width: 100%;

  padding-top: 156px;

  padding-bottom: 90px;
}


.contact-header-card {

  max-width: 900px;

  padding:
    48px;
}


.contact-header-content {

  position: relative;

  z-index: 6;

  display: flex;

  align-items: flex-start;

  gap: 24px;
}


.contact-header-icon {

  flex:
    0 0 56px;

  width: 56px;
  height: 56px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #0354a5;

  border:
    1px solid rgba(255, 255, 255, .90);

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #e9f8ff
    );

  box-shadow:
    0 10px 25px rgba(3, 84, 165, .08),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}


.contact-header-copy {

  min-width: 0;
}


.contact-eyebrow {

  margin: 0;

  color: #0354a5;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .14em;

  line-height: 1.4;

  text-transform: uppercase;
}


.contact-page-title {

  max-width: 800px;

  margin:
    14px 0 0;

  color: #061a31;

  font-size:
    clamp(42px, 5vw, 68px);

  font-weight: 600;

  line-height: 1.04;

  letter-spacing: -.045em;
}


.contact-page-description {

  max-width: 680px;

  margin:
    22px 0 0;

  color: #60758b;

  font-size: 17px;

  line-height: 1.75;
}


/* =========================================================
   SECTION HEADING
========================================================= */

.contact-section-heading {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 40px;

  margin-bottom: 42px;
}


.contact-section-eyebrow {

  margin: 0;

  color: #0354a5;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .15em;

  text-transform: uppercase;
}


.contact-section-title {

  max-width: 650px;

  margin:
    9px 0 0;

  color: #102a43;

  font-size:
    clamp(30px, 3vw, 43px);

  font-weight: 650;

  line-height: 1.12;

  letter-spacing: -.035em;
}


.contact-section-description {

  max-width: 420px;

  margin: 0;

  color: #60758b;

  font-size: 14px;

  line-height: 1.7;

  text-align: right;
}


/* =========================================================
   CONTACT INFORMATION
========================================================= */

.contact-information {

  width: 100%;

  padding:
    20px 0 110px;
}


.contact-information-grid {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 18px;
}


/* =========================================================
   CONTACT CARD
========================================================= */

.contact-info-card {

  position: relative;

  min-width: 0;

  overflow: hidden;

  padding: 26px;

  border:
    1px solid rgba(255, 255, 255, .78);

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, .82),
      rgba(245, 251, 255, .68)
    );

  backdrop-filter:
    blur(18px);

  -webkit-backdrop-filter:
    blur(18px);

  box-shadow:
    0 16px 40px rgba(3, 84, 165, .055),
    inset 0 1px 0 rgba(255, 255, 255, .95);

  transition:
    transform .45s cubic-bezier(.22, 1, .36, 1),
    box-shadow .45s ease,
    border-color .45s ease;
}


.contact-info-card::before {

  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  top: -100px;
  right: -100px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .13),
      transparent 70%
    );

  pointer-events: none;
}


.contact-info-card:hover {

  transform:
    translateY(-6px);

  border-color:
    rgba(11, 120, 199, .20);

  box-shadow:
    0 25px 50px rgba(3, 84, 165, .10),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}


.contact-card-top {

  position: relative;

  z-index: 2;

  display: flex;

  align-items: center;

  justify-content: space-between;
}


.contact-info-icon {

  width: 48px;
  height: 48px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #0757a6;

  border:
    1px solid rgba(255, 255, 255, .90);

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #e7f7ff
    );

  box-shadow:
    0 9px 22px rgba(3, 84, 165, .07),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}


.contact-card-number {

  color:
    rgba(3, 84, 165, .28);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .10em;
}


.contact-info-title {

  position: relative;

  z-index: 2;

  margin:
    20px 0 0;

  color: #102a43;

  font-size: 17px;

  font-weight: 700;

  line-height: 1.3;
}


.contact-info-text {

  position: relative;

  z-index: 2;

  margin:
    10px 0 0;

  color: #60758b;

  font-size: 14px;

  line-height: 1.7;
}


.contact-info-link {

  position: relative;

  z-index: 2;

  display: block;

  margin-top: 10px;

  color: #60758b;

  font-size: 14px;

  line-height: 1.7;

  text-decoration: none;

  transition:
    color .2s ease;
}


.contact-info-link:hover {

  color: #0757a6;
}


.contact-email {

  overflow-wrap: anywhere;
}


.contact-card-link {

  position: relative;

  z-index: 3;

  display: inline-flex;

  align-items: center;

  gap: 6px;

  margin-top: 20px;

  color: #0757a6;

  font-size: 11px;

  font-weight: 750;

  text-decoration: none;

  transition:
    gap .35s cubic-bezier(.22, 1, .36, 1),
    color .2s ease;
}


.contact-card-link:hover {

  gap: 10px;

  color: #034681;
}


/* =========================================================
   STATUS
========================================================= */

.contact-status {

  position: relative;

  z-index: 2;

  display: inline-flex;

  align-items: center;

  gap: 7px;

  margin-top: 19px;

  padding:
    7px 10px;

  border:
    1px solid rgba(44, 168, 113, .15);

  border-radius: 999px;

  color: #287a5a;

  background:
    rgba(235, 251, 243, .80);

  font-size: 9px;

  font-weight: 750;

  letter-spacing: .03em;
}


.contact-status-dot {

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #32a36e;

  box-shadow:
    0 0 0 4px rgba(50, 163, 110, .10);
}


/* =========================================================
   MAIN CONTACT SECTION
========================================================= */

.contact-main-section {

  width: 100%;

  padding:
    20px 0 110px;
}


.contact-main-grid {

  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(0, .85fr);

  gap: 24px;

  align-items: stretch;
}


/* =========================================================
   MAP CARD
========================================================= */

.contact-map-card {

  min-width: 0;

  overflow: hidden;

  border:
    1px solid rgba(255, 255, 255, .78);

  border-radius: 28px;

  background:
    rgba(255, 255, 255, .72);

  box-shadow:
    0 20px 50px rgba(3, 84, 165, .07),
    inset 0 1px 0 rgba(255, 255, 255, .96);
}


.contact-map-placeholder {

  position: relative;

  width: 100%;

  min-height: 440px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #dff4ff,
      #f1faff 48%,
      #d9edf9
    );
}


/* =========================================================
   MAP GRID
========================================================= */

.map-grid {

  position: absolute;

  inset: 0;

  opacity: .45;

  background-image:
    linear-gradient(
      rgba(3, 84, 165, .07) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(3, 84, 165, .07) 1px,
      transparent 1px
    );

  background-size:
    48px 48px;

  transform:
    rotate(-5deg)
    scale(1.15);
}


/* =========================================================
   MAP ORBS
========================================================= */

.map-orb {

  position: absolute;

  border-radius: 50%;

  pointer-events: none;
}


.map-orb-one {

  width: 430px;
  height: 430px;

  top: -220px;
  left: -180px;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .18),
      transparent 70%
    );
}


.map-orb-two {

  width: 420px;
  height: 420px;

  right: -180px;
  bottom: -220px;

  background:
    radial-gradient(
      circle,
      rgba(7, 87, 166, .14),
      transparent 70%
    );
}


/* =========================================================
   MAP CONTENT
========================================================= */

.contact-map-content {

  position: relative;

  z-index: 5;

  width:
    min(330px, calc(100% - 40px));

  padding:
    31px 27px;

  text-align: center;

  border:
    1px solid rgba(255, 255, 255, .82);

  border-radius: 22px;

  background:
    rgba(255, 255, 255, .64);

  backdrop-filter:
    blur(18px);

  -webkit-backdrop-filter:
    blur(18px);

  box-shadow:
    0 20px 45px rgba(3, 84, 165, .09),
    inset 0 1px 0 rgba(255, 255, 255, .96);
}


.contact-map-icon {

  width: 58px;
  height: 58px;

  margin-inline: auto;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #0757a6;

  border:
    1px solid rgba(255, 255, 255, .90);

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #e8f8ff
    );

  box-shadow:
    0 10px 25px rgba(3, 84, 165, .08);
}


.contact-map-label {

  margin:
    17px 0 0;

  color: #0757a6;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .15em;
}


.contact-map-title {

  margin:
    8px 0 0;

  color: #102a43;

  font-size: 18px;

  font-weight: 750;
}


.contact-map-description {

  margin:
    9px 0 0;

  color: #60758b;

  font-size: 12px;

