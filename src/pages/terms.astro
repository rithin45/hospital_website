---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout
  title="Terms & Conditions | Health Vision Hospital"
  description="Terms and Conditions for the Health Vision Hospital website."
>
  <Navbar />

  <main>

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="legal-page-header">

      <div class="container-main">

        <div class="legal-page-header-content">

          <p class="legal-eyebrow">
            Legal
          </p>

          <h1 class="legal-page-title">
            Terms & Conditions
          </h1>

          <p class="legal-updated">
            Last updated: September 2026
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         TERMS CONTENT
    ====================================================== -->

    <section class="legal-content-section">

      <div class="container-main">

        <article class="legal-content">

          <h2>
            1. Acceptance of Terms
          </h2>

          <p>
            By accessing and using the Health Vision Hospital website,
            you agree to comply with these Terms & Conditions.
          </p>

          <p>
            If you do not agree with these terms, please discontinue use
            of the website.
          </p>


          <h2>
            2. Website Information
          </h2>

          <p>
            The information provided on this website is intended for
            general informational purposes.
          </p>

          <p>
            While reasonable efforts may be made to keep information
            accurate and current, Health Vision Hospital does not
            guarantee that all information on the website will always be
            complete, accurate or up to date.
          </p>


          <h2>
            3. Medical Disclaimer
          </h2>

          <p>
            Information available on this website should not be considered
            a substitute for professional medical advice, diagnosis or
            treatment.
          </p>

          <p>
            Patients should consult an appropriately qualified healthcare
            professional regarding their individual medical conditions.
          </p>

          <p>
            In an emergency, seek immediate medical assistance through
            appropriate emergency services or contact the hospital
            directly.
          </p>


          <h2>
            4. Appointment Requests
          </h2>

          <p>
            Appointment forms available on this website are intended to
            submit a request for an appointment.
          </p>

          <p>
            Submitting an appointment request does not by itself guarantee
            an appointment. Appointment availability and timing are
            subject to confirmation by the hospital.
          </p>


          <h2>
            5. User Information
          </h2>

          <p>
            Users are responsible for providing accurate information when
            submitting enquiries or appointment requests through the
            website.
          </p>

          <p>
            Users should not knowingly submit false, misleading or
            unauthorized information.
          </p>


          <h2>
            6. Intellectual Property
          </h2>

          <p>
            Unless otherwise stated, the content, design, graphics,
            branding, logos, text and other materials on this website
            belong to or are used with permission by Health Vision
            Hospital.
          </p>

          <p>
            Website content should not be copied, reproduced, modified or
            distributed without appropriate authorization.
          </p>


          <h2>
            7. External Links
          </h2>

          <p>
            This website may contain links to external websites or
            third-party services.
          </p>

          <p>
            Health Vision Hospital is not responsible for the content,
            availability or privacy practices of external websites.
          </p>


          <h2>
            8. Website Availability
          </h2>

          <p>
            We may modify, suspend or discontinue parts of the website
            when necessary for maintenance, updates, security or other
            operational reasons.
          </p>


          <h2>
            9. Limitation of Liability
          </h2>

          <p>
            To the extent permitted by applicable law, Health Vision
            Hospital shall not be responsible for losses arising solely
            from reliance on general information provided through the
            website.
          </p>


          <h2>
            10. Changes to These Terms
          </h2>

          <p>
            These Terms & Conditions may be updated from time to time.
            Changes will be reflected on this page with an updated
            revision date.
          </p>


          <h2>
            11. Contact
          </h2>

          <p>
            If you have questions regarding these Terms & Conditions,
            please contact:
          </p>

          <p class="legal-contact">

            <strong>
              Email:
            </strong>

            <a
              href="mailto:info@healthvisionhospital.org"
            >
              info@healthvisionhospital.org
            </a>

          </p>

        </article>

      </div>

    </section>

  </main>
</Layout>


<style>

/* =========================================================
   LEGAL PAGE HEADER
========================================================= */

.legal-page-header {
  width: 100%;

  padding-top: 156px;
  padding-bottom: 78px;

  background:
    linear-gradient(
      180deg,
      #eaf8ff 0%,
      #f6fbff 100%
    );
}


.legal-page-header-content {
  max-width: 900px;

  min-width: 0;
}


.legal-eyebrow {
  margin: 0;

  color: #0757a6;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: 0.14em;
  line-height: 1.4;

  text-transform: uppercase;
}


.legal-page-title {
  margin: 18px 0 0;

  color: #061a31;

  font-size:
    clamp(
      42px,
      5vw,
      60px
    );

  font-weight: 600;

  line-height: 1.05;

  letter-spacing: -0.045em;
}


.legal-updated {
  margin: 18px 0 0;

  color: #60758b;

  font-size: 14px;

  line-height: 1.6;
}


/* =========================================================
   LEGAL CONTENT
========================================================= */

.legal-content-section {
  width: 100%;

  padding-top: 80px;
  padding-bottom: 100px;

  background: #ffffff;
}


.legal-content {
  /*
   * The global container controls the page alignment.
   * The article itself is narrower for comfortable reading.
   */
  max-width: 900px;

  margin-inline: auto;

  min-width: 0;

  color: #475f75;

  font-size: 15px;

  line-height: 1.85;
}


/* =========================================================
   HEADINGS
========================================================= */

.legal-content h2 {
  margin: 48px 0 0;

  color: #102a43;

  font-size: 23px;

  font-weight: 700;

  line-height: 1.3;

  letter-spacing: -0.02em;
}


.legal-content h2:first-child {
  margin-top: 0;
}


/* =========================================================
   PARAGRAPHS
========================================================= */

.legal-content p {
  max-width: 850px;

  margin: 18px 0 0;
}


.legal-content h2 + p {
  margin-top: 16px;
}


/* =========================================================
   CONTACT
========================================================= */

.legal-contact {
  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 6px;
}


.legal-contact strong {
  color: #3f5f78;
}


.legal-contact a {
  color: #0757a6;

  font-weight: 600;

  text-decoration: none;

  transition:
    color 180ms ease;
}


.legal-contact a:hover {
  color: #034681;

  text-decoration: underline;
}


/* =========================================================
   LARGE DESKTOP
========================================================= */

@media (min-width: 1440px) {

  .legal-page-header {
    padding-top: 166px;
    padding-bottom: 90px;
  }


  .legal-content-section {
    padding-top: 95px;
    padding-bottom: 115px;
  }

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1023px) {

  .legal-page-header {
    padding-top: 138px;
    padding-bottom: 68px;
  }


  .legal-content-section {
    padding-top: 70px;
    padding-bottom: 80px;
  }


  .legal-content {
    max-width: 820px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 640px) {

  .legal-page-header {
    padding-top: 122px;
    padding-bottom: 58px;
  }


  .legal-page-title {
    margin-top: 14px;

    font-size:
      clamp(
        36px,
        10vw,
        48px
      );
  }


  .legal-updated {
    margin-top: 15px;

    font-size: 13px;
  }


  .legal-content-section {
    padding-top: 60px;
    padding-bottom: 70px;
  }


  .legal-content {
    font-size: 14px;

    line-height: 1.8;
  }


  .legal-content h2 {
    margin-top: 40px;

    font-size: 21px;
  }


  .legal-content h2 + p {
    margin-top: 14px;
  }


  .legal-content p {
    margin-top: 16px;
  }


  .legal-contact {
    align-items: flex-start;

    flex-direction: column;

    gap: 3px;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 380px) {

  .legal-page-header {
    padding-top: 116px;
    padding-bottom: 52px;
  }


  .legal-page-title {
    font-size: 34px;
  }


  .legal-content-section {
    padding-top: 52px;
  }


  .legal-content h2 {
    font-size: 20px;
  }

}

</style>