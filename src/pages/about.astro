---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout
  title="About Health Vision Hospital | Palakkad, Kerala"
  description="Learn about Health Vision Hospital in Palakkad, Kerala, our patient-focused approach to healthcare and our commitment to compassionate medical care."
>
  <Navbar />

  <main class="about-page-wrapper">
    <!-- Ambient Background Light Orbs -->
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <div class="glow-orb orb-3"></div>

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->
    <section class="about-page-header">
      <div class="container-main">
        <div class="about-page-header-content glass-card-premium">
          <div class="card-top-reflection"></div>
          <div class="card-shine-sweep"></div>

          <div class="card-relative-content">
            <p class="about-eyebrow">
              About Health Vision Hospital
            </p>

            <h1 class="about-page-title">
              Compassionate healthcare with a vision for better living
            </h1>

            <p class="about-page-description">
              We are committed to providing accessible, dependable and
              patient-focused healthcare in a comfortable environment.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
         INTRODUCTION
    ====================================================== -->
    <section class="about-introduction">
      <div class="container-main">
        <div class="about-introduction-grid">
          <!-- IMAGE -->
          <div class="about-hospital-image glass-card-premium">
            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="about-image-content glass-inner-pill">
              <p class="about-image-title">
                Hospital Image
              </p>

              <p class="about-image-subtitle">
                Replace with actual hospital photograph
              </p>
            </div>
          </div>

          <!-- CONTENT -->
          <div class="about-introduction-content glass-card-premium">
            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="card-relative-content">
              <p class="about-eyebrow">
                Who We Are
              </p>

              <h2 class="about-section-title">
                Care that puts patients first
              </h2>

              <p class="about-body-text">
                Health Vision Hospital is dedicated to delivering quality
                healthcare through professional medical services, modern
                facilities and a compassionate approach to every patient.
              </p>

              <p class="about-body-text">
                Our goal is to create a healthcare experience where patients
                and families feel informed, respected and cared for throughout
                their journey.
              </p>

              <!-- STAT CARDS -->
              <div class="about-stats">
                <div class="about-stat-card glass-stat-premium">
                  <div class="stat-top-reflection"></div>
                  <p class="about-stat-number">
                    24/7
                  </p>

                  <p class="about-stat-label">
                    Patient Support
                  </p>
                </div>

                <div class="about-stat-card glass-stat-premium">
                  <div class="stat-top-reflection"></div>
                  <p class="about-stat-number">
                    Expert
                  </p>

                  <p class="about-stat-label">
                    Medical Team
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
         MISSION / VISION
    ====================================================== -->
    <section class="about-mission">
      <div class="container-main">
        <div class="about-mission-grid">
          <!-- MISSION -->
          <article class="about-mission-card glass-card-premium">
            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="about-mission-card-inner card-relative-content">
              <p class="about-eyebrow">
                Our Mission
              </p>

              <h2 class="about-card-title">
                Making quality care accessible
              </h2>

              <p class="about-body-text">
                To provide reliable healthcare services while maintaining
                compassion, professionalism and respect for every patient.
              </p>
            </div>
          </article>

          <!-- VISION -->
          <article class="about-mission-card glass-card-premium">
            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="about-mission-card-inner card-relative-content">
              <p class="about-eyebrow">
                Our Vision
              </p>

              <h2 class="about-card-title">
                A healthier community
              </h2>

              <p class="about-body-text">
                To build a trusted healthcare environment focused on
                better outcomes, modern medical practices and patient
                wellbeing.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
         CTA
    ====================================================== -->
    <section class="about-cta">
      <div class="container-main">
        <div class="about-cta-inner glass-card-cta">
          <div class="card-top-reflection"></div>
          <div class="card-shine-sweep"></div>

          <div class="card-relative-content">
            <h2 class="about-cta-title">
              We're here when you need us
            </h2>

            <p class="about-cta-description">
              Get in touch with our team or request an appointment.
            </p>

            <div class="about-cta-actions">
              <!-- PREMIUM BUTTON PRIMARY -->
              <a href="/appointment" class="btn-premium">
                <div class="btn-premium-shine"></div>
                <div class="btn-premium-content">
                  <span class="btn-premium-label">Quick Booking</span>
                  <span class="btn-premium-text">Book Appointment</span>
                </div>
                <div class="btn-premium-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </a>

              <!-- PREMIUM BUTTON SECONDARY -->
              <a href="/contact" class="btn-premium btn-premium-alt">
                <div class="btn-premium-shine"></div>
                <div class="btn-premium-content">
                  <span class="btn-premium-label">Get In Touch</span>
                  <span class="btn-premium-text">Contact Us</span>
                </div>
                <div class="btn-premium-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =========================================================
     PAGE WRAPPER & BACKGROUND ATMOSPHERE
     ========================================================= */

  .about-page-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #edf5fd;
  }

  /* Ambient Glow Orbs */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  .orb-1 {
    width: 550px;
    height: 550px;
    top: -100px;
    left: -120px;
    background: radial-gradient(circle, rgba(60, 195, 252, 0.3) 0%, rgba(11, 120, 199, 0.1) 70%, transparent 100%);
  }

  .orb-2 {
    width: 650px;
    height: 650px;
    top: 35%;
    right: -150px;
    background: radial-gradient(circle, rgba(3, 84, 165, 0.22) 0%, rgba(60, 195, 252, 0.12) 70%, transparent 100%);
  }

  .orb-3 {
    width: 700px;
    height: 700px;
    bottom: -150px;
    left: 15%;
    background: radial-gradient(circle, rgba(60, 195, 252, 0.25) 0%, rgba(3, 84, 165, 0.15) 70%, transparent 100%);
  }

  section {
    position: relative;
    z-index: 1;
  }

  .card-relative-content {
    position: relative;
    z-index: 2;
  }

  /* =========================================================
     GLOBAL PREMIUM GLASS CARDS (Matching Button Aesthetics)
     ========================================================= */

  .glass-card-premium {
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.58);
    backdrop-filter: blur(24px) saturate(200%);
    -webkit-backdrop-filter: blur(24px) saturate(200%);

    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 32px;

    box-shadow:
      0 22px 50px rgba(15, 118, 110, 0.08),
      0 7px 18px rgba(15, 118, 110, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04);

    transition:
      transform .5s cubic-bezier(.22, 1, .36, 1),
      box-shadow .5s ease,
      background .5s ease,
      border-color .5s ease;
  }

  .glass-card-premium:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.75);
    border-color: rgba(255, 255, 255, 0.95);

    box-shadow:
      0 30px 62px rgba(15, 118, 110, 0.14),
      0 10px 22px rgba(15, 118, 110, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04);
  }

  /* Premium Card Specular Top Reflection */
  .card-top-reflection {
    position: absolute;
    top: 1px;
    left: 24px;
    right: 24px;
    height: 1px;
    background: rgba(255, 255, 255, 0.85);
    pointer-events: none;
    z-index: 2;
  }

  /* Premium Card Shine Sweep */
  .card-shine-sweep {
    position: absolute;
    top: -100%;
    left: -45%;
    width: 35%;
    height: 300%;
    transform: rotate(22deg);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.35),
      transparent
    );
    pointer-events: none;
    z-index: 2;
    transition: left .8s cubic-bezier(.22, 1, .36, 1);
  }

  .glass-card-premium:hover .card-shine-sweep {
    left: 125%;
  }

  /* =========================================================
     PAGE HEADER
     ========================================================= */

  .about-page-header {
    width: 100%;
    padding-top: 156px;
    padding-bottom: 90px;
  }

  .about-page-header-content {
    max-width: 820px;
    min-width: 0;
    padding: 50px;
  }

  .about-eyebrow {
    margin: 0;
    color: #0354a5;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .about-page-title {
    max-width: 820px;
    margin: 18px 0 0;
    color: #061a31;
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .about-page-description {
    max-width: 680px;
    margin: 24px 0 0;
    color: #60758b;
    font-size: 17px;
    line-height: 1.75;
  }

  /* =========================================================
     INTRODUCTION
     ========================================================= */

  .about-introduction {
    width: 100%;
    padding-top: 20px;
    padding-bottom: 100px;
  }

  .about-introduction-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 80px;
  }

  .about-introduction-content {
    min-width: 0;
    max-width: 620px;
    padding: 50px;
  }

  .about-section-title {
    max-width: 580px;
    margin: 14px 0 0;
    color: #102a43;
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .about-body-text {
    max-width: 620px;
    margin: 22px 0 0;
    color: #60758b;
    font-size: 16px;
    line-height: 1.8;
  }

  /* =========================================================
     HOSPITAL IMAGE
     ========================================================= */

  .about-hospital-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glass-inner-pill {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 22px 32px;
    border-radius: 20px;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.95),
      rgba(240, 253, 250, 0.85)
    );
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  .about-image-title {
    margin: 0;
    color: #0354a5;
    font-size: 19px;
    font-weight: 700;
  }

  .about-image-subtitle {
    margin: 8px 0 0;
    color: rgba(3, 84, 165, 0.72);
    font-size: 13px;
  }

  /* =========================================================
     STATS
     ========================================================= */

  .about-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 30px;
  }

  .glass-stat-premium {
    position: relative;
    min-width: 0;
    padding: 22px;
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.75) 0%,
      rgba(238, 248, 253, 0.65) 100%
    );
    box-shadow:
      0 12px 28px rgba(15, 118, 110, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04);
    transition: transform .4s ease, background .4s ease;
  }

  .glass-stat-premium:hover {
    transform: translateY(-2px);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(238, 248, 253, 0.82) 100%
    );
  }

  .stat-top-reflection {
    position: absolute;
    top: 1px;
    left: 14px;
    right: 14px;
    height: 1px;
    background: rgba(255, 255, 255, 0.8);
  }

  .about-stat-number {
    margin: 0;
    color: #0354a5;
    font-size: 27px;
    font-weight: 750;
    line-height: 1;
  }

  .about-stat-label {
    margin: 8px 0 0;
    color: #60758b;
    font-size: 13px;
    font-weight: 600;
  }

  /* =========================================================
     MISSION / VISION
     ========================================================= */

  .about-mission {
    width: 100%;
    padding-top: 20px;
    padding-bottom: 100px;
  }

  .about-mission-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .about-mission-card {
    min-width: 0;
    border-radius: 32px;
  }

  .about-mission-card-inner {
    padding: 40px;
  }

  .about-card-title {
    max-width: 500px;
    margin: 14px 0 0;
    color: #102a43;
    font-size: 27px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  /* =========================================================
     CTA SECTION
     ========================================================= */

  .about-cta {
    width: 100%;
    padding-top: 20px;
    padding-bottom: 110px;
  }

  .glass-card-cta {
    position: relative;
    overflow: hidden;
    padding: 70px 40px;
    border-radius: 36px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: linear-gradient(
      135deg,
      rgba(3, 84, 165, 0.92) 0%,
      rgba(11, 120, 199, 0.88) 52%,
      rgba(60, 195, 252, 0.92) 100%
    );
    backdrop-filter: blur(28px) saturate(200%);
    -webkit-backdrop-filter: blur(28px) saturate(200%);

    box-shadow:
      0 30px 65px rgba(15, 118, 110, 0.28),
      0 10px 25px rgba(15, 118, 110, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
  }

  .about-cta-inner {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }

  .about-cta-title {
    margin: 0;
    color: #ffffff;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .about-cta-description {
    max-width: 580px;
    margin: 18px auto 0;
    color: rgba(221, 245, 255, 0.92);
    font-size: 16px;
    line-height: 1.7;
  }

  .about-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  /* =========================================================
     GLOBAL PREMIUM BUTTON STYLING (User Reference)
     ========================================================= */

  .btn-premium {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;

    min-height: 68px;
    padding: 8px 8px 8px 21px;

    overflow: hidden;

    color: #fff;
    text-decoration: none;

    border: 1px solid rgba(255, 255, 255, 0.30);
    border-radius: 22px;

    background: linear-gradient(
      135deg,
      #0354A5 0%,
      #0B78C7 52%,
      #3CC3FC 100%
    );

    box-shadow:
      0 22px 50px rgba(15, 118, 110, 0.22),
      0 7px 18px rgba(15, 118, 110, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 0.30),
      inset 0 -1px 0 rgba(0, 0, 0, 0.08);

    transition:
      transform .5s cubic-bezier(.22, 1, .36, 1),
      box-shadow .5s ease;
  }

  .btn-premium::before {
    content: "";
    position: absolute;
    top: 1px;
    left: 20px;
    right: 20px;
    height: 1px;
    background: rgba(255, 255, 255, 0.42);
    pointer-events: none;
  }

  .btn-premium:hover {
    transform: translateY(-4px);

    box-shadow:
      0 30px 62px rgba(15, 118, 110, 0.27),
      0 10px 22px rgba(15, 118, 110, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.38),
      inset 0 -1px 0 rgba(0, 0, 0, 0.08);
  }

  /* SECONDARY BUTTON GLASS VARIANT */
  .btn-premium-alt {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.08) 100%
    );
    border-color: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .btn-premium-alt:hover {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.28) 0%,
      rgba(255, 255, 255, 0.14) 100%
    );
    border-color: rgba(255, 255, 255, 0.7);
  }

  /* BUTTON CONTENT */
  .btn-premium-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .btn-premium-label {
    color: rgba(255, 255, 255, 0.75);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .btn-premium-text {
    color: #fff;
    font-size: 13px;
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -.01em;
    white-space: nowrap;
  }

  /* BUTTON ARROW */
  .btn-premium-arrow {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;

    width: 52px;
    height: 52px;

    color: #0354A5;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 17px;

    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(240, 253, 250, 0.88)
    );

    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 1);

    transition:
      transform .5s cubic-bezier(.22, 1, .36, 1),
      box-shadow .5s ease;
  }

  .btn-premium:hover .btn-premium-arrow {
    transform: rotate(3deg) scale(1.04);

    box-shadow:
      0 12px 26px rgba(0, 0, 0, 0.11),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  /* BUTTON SHINE */
  .btn-premium-shine {
    position: absolute;
    top: -100%;
    left: -45%;
    width: 35%;
    height: 300%;
    transform: rotate(22deg);

    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.22),
      transparent
    );

    pointer-events: none;
    transition: left .8s cubic-bezier(.22, 1, .36, 1);
  }

  .btn-premium:hover .btn-premium-shine {
    left: 125%;
  }

  /* =========================================================
     RESPONSIVE BREAKPOINTS
     ========================================================= */

  @media (min-width: 1440px) {
    .about-page-header {
      padding-top: 166px;
      padding-bottom: 105px;
    }

    .about-introduction {
      padding-bottom: 115px;
    }

    .about-introduction-grid {
      gap: 100px;
    }

    .about-mission {
      padding-bottom: 115px;
    }
  }

  @media (max-width: 1023px) {
    .about-page-header {
      padding-top: 138px;
      padding-bottom: 75px;
    }

    .about-introduction {
      padding-bottom: 80px;
    }

    .about-introduction-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .about-introduction-content,
    .about-hospital-image {
      max-width: 760px;
    }

    .about-mission {
      padding-bottom: 80px;
    }
  }

  @media (max-width: 640px) {
    .about-page-header {
      padding-top: 122px;
      padding-bottom: 64px;
    }

    .about-page-header-content,
    .about-introduction-content,
    .glass-card-cta {
      padding: 32px 20px;
      border-radius: 24px;
    }

    .about-page-title {
      margin-top: 14px;
      font-size: clamp(36px, 10vw, 48px);
    }

    .about-page-description {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.7;
    }

    .about-introduction-grid {
      gap: 42px;
    }

    .about-hospital-image {
      border-radius: 24px;
    }

    .about-section-title {
      font-size: 32px;
    }

    .about-body-text {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.75;
    }

    .about-stats {
      gap: 10px;
      margin-top: 24px;
    }

    .glass-stat-premium {
      padding: 18px;
      border-radius: 18px;
    }

    .about-stat-number {
      font-size: 23px;
    }

    .about-stat-label {
      font-size: 12px;
    }

    .about-mission-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .about-mission-card {
      border-radius: 24px;
    }

    .about-mission-card-inner {
      padding: 28px 20px;
