<script>
  const form = document.querySelector<HTMLFormElement>(".schedule-form");
  const dateInput = document.querySelector<HTMLInputElement>("#schedule-date");

  if (dateInput) {
    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, "0");
    const day = String(today.getDate()).padStart(2, "0");
    dateInput.min = `${year}-${month}-${day}`;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    /*
     * Frontend-only appointment request for now.
     * Connect this form to your backend/email service
     * when the appointment API is ready.
     */

    const submitButton = form.querySelector<HTMLButtonElement>(".schedule-submit");
    const label = form.querySelector<HTMLElement>(".schedule-submit-text");

    if (!submitButton || !label) return;

    const originalText = label.textContent || "Request Appointment";

    label.textContent = "Request submitted";
    submitButton.disabled = true;

    window.setTimeout(() => {
      label.textContent = originalText;
      submitButton.disabled = false;
      form.reset();
    }, 2200);
  });
</script>