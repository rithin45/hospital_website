---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

import {
  Building2,
  BedDouble,
  FlaskConical,
  ScanLine,
  ShieldCheck,
  Clock3,
  ArrowRight,
} from "lucide-react";
---

<Layout
  title="Facilities | Health Vision Hospital"
  description="Explore the facilities and patient-focused infrastructure at Health Vision Hospital."
>
  <Navbar />

  <main class="facilities-page-wrapper">

    <!-- =====================================================
         AMBIENT BACKGROUND
    ====================================================== -->

    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <div class="glow-orb orb-3"></div>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="facilities-page-header">

      <div class="container-main">

        <div class="facilities-page-header-content glass-card-premium">

          <div class="card-top-reflection"></div>
          <div class="card-shine-sweep"></div>

          <div class="card-relative-content">

            <p class="facilities-eyebrow">
              Our Facilities
            </p>

            <h1 class="facilities-page-title">
              A comfortable environment for better healthcare
            </h1>

            <p class="facilities-page-description">
              Our facilities are designed to support patients, families and
              healthcare professionals throughout the care journey.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FACILITIES
    ====================================================== -->

    <section class="facilities-section">

      <div class="container-main">

        <div class="facilities-grid">


          <!-- =================================================
               MODERN INFRASTRUCTURE
          ================================================== -->

          <article class="facility-card glass-card-premium">

            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="card-relative-content">

              <div class="facility-icon">
                <Building2
                  size={25}
                  strokeWidth={1.8}
                />
              </div>

              <p class="facility-number">
                01
              </p>

              <h2 class="facility-title">
                Modern Infrastructure
              </h2>

              <p class="facility-description">
                A thoughtfully designed healthcare environment focused on
                comfort, accessibility and efficient patient care.
              </p>

              <div class="facility-bottom-line"></div>

            </div>

          </article>


          <!-- =================================================
               PATIENT ROOMS
          ================================================== -->

          <article class="facility-card glass-card-premium">

            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="card-relative-content">

              <div class="facility-icon">
                <BedDouble
                  size={25}
                  strokeWidth={1.8}
                />
              </div>

              <p class="facility-number">
                02
              </p>

              <h2 class="facility-title">
                Patient Rooms
              </h2>

              <p class="facility-description">
                Comfortable patient spaces designed to support rest,
                recovery and family visits.
              </p>

              <div class="facility-bottom-line"></div>

            </div>

          </article>


          <!-- =================================================
               LABORATORY
          ================================================== -->

          <article class="facility-card glass-card-premium">

            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="card-relative-content">

              <div class="facility-icon">
                <FlaskConical
                  size={25}
                  strokeWidth={1.8}
                />
              </div>

              <p class="facility-number">
                03
              </p>

              <h2 class="facility-title">
                Laboratory Services
              </h2>

              <p class="facility-description">
                Diagnostic laboratory facilities supporting medical
                evaluation and patient care.
              </p>

              <div class="facility-bottom-line"></div>

            </div>

          </article>


          <!-- =================================================
               DIAGNOSTIC FACILITIES
          ================================================== -->

          <article class="facility-card glass-card-premium">

            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="card-relative-content">

              <div class="facility-icon">
                <ScanLine
                  size={25}
                  strokeWidth={1.8}
                />
              </div>

              <p class="facility-number">
                04
              </p>

              <h2 class="facility-title">
                Diagnostic Facilities
              </h2>

              <p class="facility-description">
                Diagnostic support to help healthcare professionals assess
                patient conditions.
              </p>

              <div class="facility-bottom-line"></div>

            </div>

          </article>


          <!-- =================================================
               PATIENT SAFETY
          ================================================== -->

          <article class="facility-card glass-card-premium">

            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="card-relative-content">

              <div class="facility-icon">
                <ShieldCheck
                  size={25}
                  strokeWidth={1.8}
                />
              </div>

              <p class="facility-number">
                05
              </p>

              <h2 class="facility-title">
                Patient Safety
              </h2>

              <p class="facility-description">
                Healthcare practices focused on maintaining a safe and
                supportive environment for patients.
              </p>

              <div class="facility-bottom-line"></div>

            </div>

          </article>


          <!-- =================================================
               PATIENT SUPPORT
          ================================================== -->

          <article class="facility-card glass-card-premium">

            <div class="card-top-reflection"></div>
            <div class="card-shine-sweep"></div>

            <div class="card-relative-content">

              <div class="facility-icon">
                <Clock3
                  size={25}
                  strokeWidth={1.8}
                />
              </div>

              <p class="facility-number">
                06
              </p>

              <h2 class="facility-title">
                Patient Support
              </h2>

              <p class="facility-description">
                Support services designed to make the patient experience
                easier and more comfortable.
              </p>

              <div class="facility-bottom-line"></div>

            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         IMAGE SHOWCASE
    ====================================================== -->

    <section class="facilities-showcase">

      <div class="container-main">

        <div class="facilities-showcase-header">

          <p class="facilities-eyebrow">
            Inside Health Vision
          </p>

          <h2 class="facilities-showcase-title">
            Our hospital environment
          </h2>

          <p class="facilities-showcase-description">
            Explore the spaces designed to make every stage of the
            healthcare journey more comfortable.
          </p>

        </div>


        <!-- =================================================
             GALLERY
        ================================================== -->

        <div class="facilities-gallery">


          <!-- Reception -->

          <div class="facility-image-card">

            <div class="facility-image-placeholder">

              <div class="facility-image-glow"></div>

              <div class="facility-image-placeholder-content">

                <span class="facility-image-label">
                  Reception Image
                </span>

                <span class="facility-image-caption">
                  Welcoming spaces for every visitor
                </span>

              </div>

            </div>

          </div>


          <!-- Patient Room -->

          <div class="facility-image-card">

            <div class="facility-image-placeholder">

              <div class="facility-image-glow"></div>

              <div class="facility-image-placeholder-content">

                <span class="facility-image-label">
                  Patient Room Image
                </span>

                <span class="facility-image-caption">
                  Comfortable spaces for rest and recovery
                </span>

              </div>

            </div>

          </div>


          <!-- Facility -->

          <div class="facility-image-card">

            <div class="facility-image-placeholder">

              <div class="facility-image-glow"></div>

              <div class="facility-image-placeholder-content">

                <span class="facility-image-label">
                  Facility Image
                </span>

                <span class="facility-image-caption">
                  Designed around patient needs
                </span>

              </div>

            </div>

          </div>


        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="facilities-cta">

      <div class="container-main">

        <div class="facilities-cta-card">

          <div class="cta-glow cta-glow-one"></div>
          <div class="cta-glow cta-glow-two"></div>

          <div class="cta-top-highlight"></div>

          <div class="card-relative-content">

            <div class="facilities-cta-inner">

              <p class="cta-eyebrow">
                Health Vision Hospital
              </p>

              <h2 class="facilities-cta-title">
                Visit Health Vision Hospital
              </h2>

              <p class="facilities-cta-description">
                Contact our team to learn more about our facilities
                or request an appointment.
              </p>


              <!-- =================================================
                   PREMIUM CTA BUTTON
              ================================================== -->

              <a
                href="/contact"
                class="premium-button premium-button-cta"
              >

                <span class="premium-button-shine"></span>

                <span class="premium-button-content">

                  <span class="premium-button-label">
                    Get In Touch
                  </span>

                  <span class="premium-button-text">
                    Contact Us
                  </span>

                </span>

                <span class="premium-button-arrow">
                  <ArrowRight
                    size={20}
                    strokeWidth={2.4}
                  />
                </span>

              </a>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>
</Layout>


<style>

/* =========================================================
   PAGE WRAPPER
========================================================= */

.facilities-page-wrapper {

  position: relative;

  width: 100%;

  min-height: 100vh;

  overflow: hidden;

  background: #edf5fd;
}


/* =========================================================
   AMBIENT GLOW
========================================================= */

.glow-orb {

  position: absolute;

  border-radius: 50%;

  filter: blur(100px);

  pointer-events: none;

  z-index: 0;
}


.orb-1 {

  width: 550px;
  height: 550px;

  top: -110px;
  left: -140px;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, 0.30) 0%,
      rgba(11, 120, 199, 0.10) 70%,
      transparent 100%
    );
}


.orb-2 {

  width: 650px;
  height: 650px;

  top: 32%;
  right: -180px;

  background:
    radial-gradient(
      circle,
      rgba(3, 84, 165, 0.20) 0%,
      rgba(60, 195, 252, 0.11) 70%,
      transparent 100%
    );
}


.orb-3 {

  width: 700px;
  height: 700px;

  bottom: -200px;
  left: 12%;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, 0.20) 0%,
      rgba(3, 84, 165, 0.12) 70%,
      transparent 100%
    );
}


section {

  position: relative;

  z-index: 1;
}


/* =========================================================
   COMMON
========================================================= */

.card-relative-content {

  position: relative;

  z-index: 5;
}


/* =========================================================
   PREMIUM GLASS CARD
========================================================= */

.glass-card-premium {

  position: relative;

  overflow: hidden;

  background:
    rgba(255, 255, 255, 0.58);

  backdrop-filter:
    blur(24px) saturate(200%);

  -webkit-backdrop-filter:
    blur(24px) saturate(200%);

  border:
    1px solid rgba(255, 255, 255, 0.72);

  border-radius: 32px;

  box-shadow:
    0 22px 50px rgba(15, 118, 110, 0.08),
    0 7px 18px rgba(15, 118, 110, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.82),
    inset 0 -1px 0 rgba(0, 0, 0, 0.035);

  transition:
    transform .5s cubic-bezier(.22, 1, .36, 1),
    box-shadow .5s ease,
    background .5s ease,
    border-color .5s ease;
}


.glass-card-premium:hover {

  transform:
    translateY(-5px);

  background:
    rgba(255, 255, 255, 0.74);

  border-color:
    rgba(255, 255, 255, 0.95);

  box-shadow:
    0 30px 62px rgba(15, 118, 110, 0.14),
    0 10px 22px rgba(15, 118, 110, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95),
    inset 0 -1px 0 rgba(0, 0, 0, 0.04);
}


/* =========================================================
   CARD REFLECTION
========================================================= */

.card-top-reflection {

  position: absolute;

  top: 1px;

  left: 24px;
  right: 24px;

  height: 1px;

  background:
    rgba(255, 255, 255, 0.90);

  z-index: 8;

  pointer-events: none;
}


/* =========================================================
   CARD SHINE
========================================================= */

.card-shine-sweep {

  position: absolute;

  top: -100%;
  left: -45%;

  width: 35%;
  height: 300%;

  transform:
    rotate(22deg);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.34),
      transparent
    );

  z-index: 7;

  pointer-events: none;

  transition:
    left .8s cubic-bezier(.22, 1, .36, 1);
}


.glass-card-premium:hover
.card-shine-sweep {

  left: 125%;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.facilities-page-header {

  width: 100%;

  padding-top: 156px;

  padding-bottom: 90px;
}


.facilities-page-header-content {

  max-width: 820px;

  padding: 50px;
}


.facilities-eyebrow {

  margin: 0;

  color: #0354a5;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .14em;

  line-height: 1.4;

  text-transform: uppercase;
}


.facilities-page-title {

  max-width: 820px;

  margin: 18px 0 0;

  color: #061a31;

  font-size:
    clamp(42px, 5vw, 68px);

  font-weight: 600;

  line-height: 1.04;

  letter-spacing: -.045em;
}


.facilities-page-description {

  max-width: 680px;

  margin: 24px 0 0;

  color: #60758b;

  font-size: 17px;

  line-height: 1.75;
}


/* =========================================================
   FACILITIES
========================================================= */

.facilities-section {

  width: 100%;

  padding-top: 20px;

  padding-bottom: 110px;
}


.facilities-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 24px;
}


/* =========================================================
   FACILITY CARD
========================================================= */

.facility-card {

  min-width: 0;

  padding: 30px;

  border-radius: 30px;
}


/* =========================================================
   FACILITY ICON
========================================================= */

.facility-icon {

  width: 55px;
  height: 55px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #0354a5;

  border:
    1px solid rgba(255, 255, 255, .82);

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, .98),
      rgba(235, 249, 255, .86)
    );

  box-shadow:
    0 9px 22px rgba(3, 84, 165, .08),
    inset 0 1px 0 rgba(255, 255, 255, 1);

  transition:
    transform .45s cubic-bezier(.22, 1, .36, 1),
    box-shadow .45s ease;
}


.facility-card:hover
.facility-icon {

  transform:
    translateY(-2px)
    rotate(2deg)
    scale(1.04);

  box-shadow:
    0 14px 28px rgba(3, 84, 165, .13),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}


/* =========================================================
   FACILITY NUMBER
========================================================= */

.facility-number {

  margin: 24px 0 0;

  color:
    rgba(3, 84, 165, .48);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .15em;

  text-transform: uppercase;
}


/* =========================================================
   FACILITY TITLE
========================================================= */

.facility-title {

  margin: 7px 0 0;

  color: #102a43;

  font-size: 21px;

  font-weight: 700;

  line-height: 1.25;

  letter-spacing: -.025em;
}


/* =========================================================
   FACILITY DESCRIPTION
========================================================= */

.facility-description {

  max-width: 500px;

  margin: 12px 0 0;

  color: #60758b;

  font-size: 15px;

  line-height: 1.75;
}


/* =========================================================
   FACILITY BOTTOM LINE
========================================================= */

.facility-bottom-line {

  width: 42px;

  height: 2px;

  margin-top: 22px;

  border-radius: 999px;

  background:
    linear-gradient(
      90deg,
      #0354a5,
      #3cc3fc
    );

  opacity: .55;

  transition:
    width .45s cubic-bezier(.22, 1, .36, 1),
    opacity .45s ease;
}


.facility-card:hover
.facility-bottom-line {

  width: 72px;

  opacity: .9;
}


/* =========================================================
   SHOWCASE
========================================================= */

.facilities-showcase {

  width: 100%;

  padding-top: 20px;

  padding-bottom: 110px;
}


.facilities-showcase-header {

  max-width: 720px;

  margin-inline: auto;

  text-align: center;
}


.facilities-showcase-title {

  margin: 14px 0 0;

  color: #102a43;

  font-size:
    clamp(30px, 3vw, 44px);

  font-weight: 650;

  line-height: 1.12;

  letter-spacing: -.035em;
}


.facilities-showcase-description {

  max-width: 580px;

  margin: 17px auto 0;

  color: #60758b;

  font-size: 15px;

  line-height: 1.75;
}


/* =========================================================
   GALLERY
========================================================= */

.facilities-gallery {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 24px;

  margin-top: 48px;
}


.facility-image-card {

  position: relative;

  overflow: hidden;

  border-radius: 28px;
}


/* =========================================================
   IMAGE PLACEHOLDER
========================================================= */

.facility-image-placeholder {

  position: relative;

  width: 100%;

  aspect-ratio: 4 / 3;

  display: flex;

  align-items: flex-end;

  overflow: hidden;

  border:
    1px solid rgba(255, 255, 255, .80);

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      #dff5ff 0%,
      #edf9ff 48%,
      #d7effd 100%
    );

  box-shadow:
    0 18px 45px rgba(3, 70, 129, .07),
    inset 0 1px 0 rgba(255, 255, 255, .90);

  transition:
    transform .6s cubic-bezier(.22, 1, .36, 1),
    box-shadow .6s ease;
}


.facility-image-card:hover
.facility-image-placeholder {

  transform:
    translateY(-5px);

  box-shadow:
    0 28px 55px rgba(3, 70, 129, .12),
    inset 0 1px 0 rgba(255, 255, 255, .95);
}


/* =========================================================
   IMAGE LIGHT
========================================================= */

.facility-image-placeholder::before {

  content: "";

  position: absolute;

  width: 350px;
  height: 350px;

  left: -160px;
  top: -170px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .23),
      transparent 70%
    );
}


.facility-image-placeholder::after {

  content: "";

  position: absolute;

  width: 330px;
  height: 330px;

  right: -160px;
  bottom: -180px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(7, 87, 166, .15),
      transparent 70%
    );
}


/* =========================================================
   IMAGE CENTER DETAIL
========================================================= */

.facility-image-glow {

  position: absolute;

  width: 180px;
  height: 180px;

  top: 50%;
  left: 50%;

  transform:
    translate(-50%, -58%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255, 255, 255, .70),
      rgba(255, 255, 255, .18) 45%,
      transparent 70%
    );

  filter: blur(2px);
}


/* =========================================================
   IMAGE CONTENT
========================================================= */

.facility-image-placeholder-content {

  position: relative;

  z-index: 5;

  width: 100%;

  margin: 18px;

  padding: 17px 18px;

  border:
    1px solid rgba(255, 255, 255, .72);

  border-radius: 18px;

  background:
    rgba(255, 255, 255, .60);

  backdrop-filter:
    blur(16px);

  -webkit-backdrop-filter:
    blur(16px);

  box-shadow:
    0 10px 24px rgba(3, 70, 129, .07),
    inset 0 1px 0 rgba(255, 255, 255, .90);
}


.facility-image-label {

  display: block;

  color: #034681;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .02em;
}


.facility-image-caption {

  display: block;

  margin-top: 5px;

  color: #60758b;

  font-size: 12px;

  line-height: 1.5;
}


/* =========================================================
   CTA
========================================================= */

.facilities-cta {

  width: 100%;

  padding:
    20px 0 110px;
}


.facilities-cta-card {

  position: relative;

  overflow: hidden;

  padding:
    82px 40px;

  border:
    1px solid rgba(255, 255, 255, .34);

  border-radius: 36px;

  background:
    linear-gradient(
      135deg,
      #034681 0%,
      #0757a6 42%,
      #0b78c7 72%,
      #3cc3fc 100%
    );

  box-shadow:
    0 30px 65px rgba(3, 84, 165, .23),
    0 10px 25px rgba(3, 84, 165, .10),
    inset 0 1px 0 rgba(255, 255, 255, .38),
    inset 0 -1px 0 rgba(0, 0, 0, .10);
}


/* =========================================================
   CTA GLOW
========================================================= */

.cta-glow {

  position: absolute;

  border-radius: 50%;

  filter: blur(20px);

  pointer-events: none;
}


.cta-glow-one {

  width: 420px;
  height: 420px;

  top: -240px;
  right: -80px;

  background:
    radial-gradient(
      circle,
      rgba(255, 255, 255, .18),
      transparent 70%
    );
}


.cta-glow-two {

  width: 360px;
  height: 360px;

  bottom: -230px;
  left: -100px;

  background:
    radial-gradient(
      circle,
      rgba(60, 195, 252, .22),
      transparent 70%
    );
}


/* =========================================================
   CTA HIGHLIGHT
========================================================= */

.cta-top-highlight {

  position: absolute;

  top: 1px;

  left: 30px;
  right: 30px;

  height: 1px;

  background:
    rgba(255, 255, 255, .42);
}


/* =========================================================
   CTA CONTENT
========================================================= */

.facilities-cta-inner {

  max-width: 760px;

  margin-inline: auto;

  text-align: center;
}


.cta-eyebrow {

  margin: 0;

  color:
    rgba(255, 255, 255, .76);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .15em;

  text-transform: uppercase;
}


.facilities-cta-title {

  margin:
    13px 0 0;

  color: #ffffff;

  font-size:
    clamp(34px, 4vw, 50px);

  font-weight: 650;

  line-height: 1.08;

  letter-spacing: -.04em;
}


.facilities-cta-description {

  max-width: 590px;

  margin:
    19px auto 0;

  color:
    rgba(232, 248, 255, .92);

  font-size: 16px;

  line-height: 1.7;
}


/* =========================================================
   PREMIUM BUTTON
========================================================= */

.premium-button {

  position: relative;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 18px;

  overflow: hidden;

  width: 100%;

  min-height: 66px;

  margin-top: 26px;

  padding:
